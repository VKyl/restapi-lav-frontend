# Where the dev server forwards /api requests (your backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000/kmartists

# Optional: call the API directly instead of through the /api proxy
# (useful for production builds). Example: https://api.kmartists.dev
# VITE_API_URL=

# Microsoft sign-in (optional). Leave VITE_MS_CLIENT_ID empty to hide the "Continue with Microsoft" option.
# Azure portal → Microsoft Entra ID → App registrations → your app:
#   - Authentication: platform "Single-page application", redirect URI http://localhost:5173
# VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Who can sign in: common (personal + work/school), consumers (personal only),
# organizations (any work/school), or your tenant ID (one organization only).
# VITE_MS_TENANT_ID=common
